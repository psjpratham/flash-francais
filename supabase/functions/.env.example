## Local-only secrets for Supabase Edge Functions. Copy to `.env` (gitignored)
## and fill in real values. Never commit the real .env file.

## Used by the page-extraction worker's Gemini provider adapter
## (supabase/functions/_shared/gemini.ts), invoked by dispatch-import-work.
## This is the image-hybrid extraction call: each page is sent as both text
## and its own single-page PDF attachment, so this key must belong to a
## Gemini model with document/image input support.
GEMINI_API_KEY=

## Optional: overrides the default model ('gemini-2.5-flash-lite').
GEMINI_MODEL=

## Optional: overrides the default maxOutputTokens (8192).
GEMINI_MAX_OUTPUT_TOKENS=

## Reserved for future work (card generation / content enrichment) — NOT
## currently used by the extraction pipeline, which runs on Gemini above.
## (supabase/functions/_shared/deepseek.ts)
DEEPSEEK_API_KEY=

## Optional: overrides the default model ('deepseek-v4-flash'). Verified
## directly against the API for this account: only 'deepseek-v4-pro' and
## 'deepseek-v4-flash' are valid model ids — the generic 'deepseek-chat'
## alias returns an invalid_request_error here. Confirm against your own
## account before changing.
DEEPSEEK_MODEL=

## Optional: overrides the default max_tokens (8192). Requests explicitly
## send `thinking: {type: 'disabled'}` (verified live against the API) so
## reasoning_content — and its token/latency cost — never happens; this is
## just a safety ceiling for large pages, not a reasoning budget.
DEEPSEEK_MAX_OUTPUT_TOKENS=

## Used by tts-speak (supabase/functions/tts-speak) for on-demand pronunciation
## audio — the same Gemini Developer API key as GEMINI_API_KEY above works
## here too (native TTS models live on the same generativelanguage.googleapis.com
## endpoint), so this can just be left unset to reuse GEMINI_API_KEY... except
## Deno.env in tts-speak reads GEMINI_API_KEY directly, so nothing extra is
## needed here at all. Kept as a comment for discoverability only.

## Optional: overrides tts-speak's default model ('gemini-2.5-flash-preview-tts').
GEMINI_TTS_MODEL=

## Optional: overrides tts-speak's default prebuilt voice ('Kore').
GEMINI_TTS_VOICE=

## Required by dispatch-import-work: a random shared secret pg_cron sends as
## the x-cron-secret header (see supabase/migrations/20260726010000). Set the
## SAME value in Vault via `select vault.create_secret('<value>', 'cron_dispatch_secret');`
## and here via `supabase secrets set`. Never commit the real value.
CRON_DISPATCH_SECRET=
